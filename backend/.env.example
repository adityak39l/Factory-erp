# ============================================================
# Trading Engineers — DPR System : Backend environment
# Copy this file to `.env` and fill in real values.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Local MongoDB:   mongodb://127.0.0.1:27017/trading_engineers_dpr
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trading_engineers_dpr?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/trading_engineers_dpr

# --- Authentication ---
# Use a long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h

# --- Field level encryption (Aadhar / bank account numbers) ---
# MUST be exactly 64 hex characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you change this after data is saved, existing encrypted values cannot be decrypted.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- First admin account (created by `npm run seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@tradingengineers.com

# --- Email (used ONLY for admin forgot-password OTP) ---
# Leave SMTP_HOST empty during local development: the OTP is then printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trading Engineers DPR <no-reply@tradingengineers.com>"
