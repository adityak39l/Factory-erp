{
  "name": "trading-engineers-dpr",
  "version": "1.0.0",
  "private": true,
  "description": "Trading Engineers — Factory Employee Management & DPR System (Phase 1)",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "seed:demo": "npm --prefix backend run seed -- --demo",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build"
  },
  "workspaces": [],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
